#!/bin/bash
# s5-boot-halt — the equivalent of GRUB's `halt` on a machine with
# systemd-boot: it builds and installs the EFI poweroff application, and arms the
# one-shot entry for the next poweroff.
#
# WHY IT EXISTS. The rare-case branch of s5-gpu-politica powers off from GRUB
# because in that boot no Linux kernel ever gets to run: the firmware
# does its S5 with the hardware just as POST left it, and the measurement comes out clean
# (1,05 W measured on 2026-08-09). Here there is no GRUB, so the same trick is done
# with a one-shot entry that boots system/efi/s5-halt.c. The reason why
# it does NOT work to do it from a live kernel is in docs/EVIDENCE.md
# (`efi-poweroff` 19,26 W; `pm1a-acpica` 26,56 W): what saves the measurement is not
# powering off through the firmware, it is that there is no kernel.
#
# Usage:
#   sudo s5-boot-halt estado      (default) what is there and whether it is armed
#   sudo s5-boot-halt instalar    builds, signs and installs app + entry on the ESP
#   sudo s5-boot-halt armar       leaves the one-shot entry for the next poweroff
#   sudo s5-boot-halt abortar     removes it (in case you change your mind before powering off)
#
# FAIL SAFE, ALWAYS. Everything missing is named outright and the
# order is not carried out: without gnu-efi it does not build, without a signature it is not installed with
# Secure Boot enabled, without efivarfs it is not armed. In all those cases the poweroff
# continues along the normal path and only the saving is lost.
#
# IT TOUCHES NO BOOT THAT ALREADY EXISTS: it adds a new entry to the ESP and an EFI
# variable; it does not change the boot loader, the kernel, or any previous entry.
# `abortar` and uninstall.sh leave it as it was.

set -u

HERE=$(cd "$(dirname "$0")/.." && pwd)
S5_CONF=${S5_CONF:-/etc/s5-poweroff-fix.conf}
LOG=${S5_BOOT_LOG:-/var/log/s5-shutdown-pci.log}
# shellcheck source=/dev/null
. "$HERE/system/bin/s5-descubre-boot" 2>/dev/null || {
    # If the discovery script is not where it is expected, it is looked for in its
    # installation location: the module and the policy already live in /usr/local/bin.
    # shellcheck source=/dev/null
    . /usr/local/bin/s5-descubre-boot
}

say() { printf 'BOOT  %s\n' "$*"; printf 'BOOT  %s\n' "$*" >>"$LOG" 2>/dev/null || true; }

exigir_root() {
    [ "$(id -u)" = 0 ] || { echo "error: this command writes to the ESP and to efivarfs; use sudo" >&2; exit 1; }
}

# A limit of the discovery script is not always a limit for THIS order: without the
# application installed, `armar` does not work but `instalar` does. It is checked separately.
limite_para() {   # $1 = what is to be done
    case "$1" in
    instalar) [ -n "$BOOT_ESP" ] && [ -n "$BOOT_BOOTCTL" ] ;;
    armar)    [ -n "$BOOT_ESP" ] && [ -n "$BOOT_BOOTCTL" ] && [ "$BOOT_ONESHOT" = si ] \
                  && [ -n "$BOOT_EFIVARS" ] && [ -e "$BOOT_HALT_ENTRY" ] && [ -e "$BOOT_HALT_EFI" ] ;;
    esac
}

# The marker the application leaves when it runs (see system/efi/s5-halt.c). The
# name in efivarfs carries its own GUID; the first 4 bytes of the file are the
# variable's attributes, not its content.
MARCA_NOMBRE=S5HaltLastRun
MARCA_GUID=8b8c1b5e-2f1a-4b3c-9a7d-512c6e0a3f11
marca_path() { printf '%s/%s-%s' "$BOOT_EFIVARS" "$MARCA_NOMBRE" "$MARCA_GUID"; }
marca_valor() {
    local v; v=$(marca_path)
    [ -e "$v" ] || return 1
    tail -c +5 <"$v" 2>/dev/null | tr -d '\0'
}
# EFI variables are immutable (----i----); the attribute has to be removed before
# deleting them, which is what bootctl does internally.
borrar_var() {
    [ -e "$1" ] || return 0
    chattr -i "$1" 2>/dev/null || true
    rm -f "$1" 2>/dev/null || true
}

estado() {
    printf 'ESP            : %s\n' "${BOOT_ESP:-(not found)}"
    printf 'bootctl        : %s\n' "${BOOT_BOOTCTL:-(not found)}"
    printf 'one-shot entry : %s\n' "${BOOT_ONESHOT:-NO}"
    printf 'Secure Boot    : %s\n' "${BOOT_SB:-(disabled or unknown)}"
    printf 'application    : %s%s\n' "${BOOT_HALT_EFI:-(no ESP)}" \
        "$([ -n "$BOOT_HALT_EFI" ] && [ -e "$BOOT_HALT_EFI" ] && echo '  (installed)' || echo '  (missing: s5-boot-halt instalar)')"
    printf 'entry          : %s%s\n' "${BOOT_HALT_ENTRY:-(no ESP)}" \
        "$([ -n "$BOOT_HALT_ENTRY" ] && [ -e "$BOOT_HALT_ENTRY" ] && echo '  (written)' || echo '  (missing: s5-boot-halt instalar)')"

    # Arming is read from the variable, not from a state file of ours: the
    # only truth is the one systemd-boot will read when it boots. The first 4
    # bytes are the variable's attributes in efivarfs, not its content.
    v=$(ls -1 "$BOOT_EFIVARS"/LoaderEntryOneShot-* 2>/dev/null | head -1)
    if [ -n "${v:-}" ]; then
        printf 'armed          : YES (%s)\n' "$(tail -c +5 <"$v" 2>/dev/null | tr -d '\0')"
    else
        printf 'armed          : no\n'
    fi
    if [ -n "$BOOT_LIMITE" ]; then
        printf 'limit          : %s\n' "$BOOT_LIMITE"
    fi

    # The proof that the application RAN. There is no other: the poweroff happens
    # with no kernel, so neither journal nor dmesg nor the witness see it. The time is in
    # UTC (this machine's RTC runs in UTC and the firmware gives it as is), so it
    # is translated to local: reading "05:50" for a 13:50 poweroff is exactly the
    # confusion this avoids.
    if marca=$(marca_valor); then
        # The current application writes the Z; the first version did not put it, and its
        # time was UTC anyway (the firmware gives UTC). It is normalized here so that
        # an old marker is not read as if it were local.
        case "$marca" in
        *Z) marca_utc=$marca ;;
        *)  marca_utc="${marca}Z" ;;
        esac
        marca_local=$(date -d "$marca_utc" '+%Y-%m-%d %H:%M:%S %Z' 2>/dev/null || true)
        if [ -n "$marca_local" ]; then
            printf 'last poweroff  : YES, by firmware, on %s (%s)\n' "$marca_local" "$marca"
        else
            printf 'last poweroff  : YES, by firmware, on %s\n' "$marca"
        fi
    else
        printf 'last poweroff  : there is no record that the application has ever run\n'
    fi
}

instalar() {
    exigir_root
    if ! limite_para instalar; then
        echo "cannot install yet: ${BOOT_LIMITE:-missing the ESP or bootctl}" >&2
        return 1
    fi

    echo "== 1. build =="
    # `check` already says which route there is on this machine and why not the other. Choosing by its
    # output, instead of trying the one that is missing and falling back on failure, avoids showing an
    # objcopy error that is not an error: here binutils does not carry the
    # efi-app-x86_64 target, so the gnu-efi route cannot take the last step.
    if ! check_out=$(make -C "$HERE/system/efi" check 2>&1); then
        printf '%s\n' "$check_out" >&2
        return 1
    fi
    printf '%s\n' "$check_out"
    via=clang
    case "$check_out" in
    *"gnu-efi + objcopy route (efi-app-x86_64): READY"*) via=gnu-efi ;;
    esac
    if [ "$via" = gnu-efi ]; then
        if ! make -C "$HERE/system/efi"; then
            echo "the gnu-efi route failed; trying clang + lld-link"
            via=clang
            make -C "$HERE/system/efi" clang || return 1
        fi
    else
        make -C "$HERE/system/efi" clang || return 1
    fi
    echo "built by route: $via"

    echo
    echo "== 2. sign (only if needed) =="
    efi="$HERE/system/efi/s5-halt.efi"
    if [ "$BOOT_SB" = si ]; then
        # The application is signed by the user with THEIR keys: this project does
        # not install keys or touch the Secure Boot database.
        if command -v sbctl >/dev/null 2>&1; then
            sbctl sign -s "$efi" || { echo "sbctl sign failed" >&2; return 1; }
        elif command -v sbsign >/dev/null 2>&1; then
            echo "sbsign found, but the user's keys are needed:" >&2
            echo "  sbsign --key /path/db.key --cert /path/db.crt --output <efi> <efi>" >&2
            echo "and run 's5-boot-halt instalar' again." >&2
            return 1
        else
            echo "Secure Boot enabled and there is neither sbctl nor sbsign: sign it by hand" >&2
            return 1
        fi
    else
        echo "Secure Boot disabled: no need to sign"
    fi
    # The check that really matters, with the tool that knows how to do it:
    if command -v sbctl >/dev/null 2>&1; then
        sbctl verify "$efi" 2>/dev/null | sed 's/^/  /' || true
    fi

    echo
    echo "== 3. install to the ESP (nothing existing is touched) =="
    install -d -m755 "$(dirname "$BOOT_HALT_EFI")" || return 1
    install -m644 "$efi" "$BOOT_HALT_EFI" || return 1

    # The entry is written ONCE and stays: that way arming a poweroff is only
    # writing an EFI variable, without mounting /boot or writing to the ESP during
    # the poweroff window (which is exactly the problem the GRUB branch has).
    cat >"$BOOT_HALT_ENTRY" <<'EOF'
# s5-boot-halt — one-shot entry, armed by `s5-boot-halt armar` and
# consumed by systemd-boot. It is NOT deleted when used: without the LoaderEntryOneShot
# variable it is just another menu entry, and the real barrier against a loop is that the
# application deletes that variable before powering off.
title   S5 — power off from the firmware (the dGPU did not fall asleep)
efi     /EFI/s5-halt/s5-halt.efi
EOF
    chmod 0644 "$BOOT_HALT_ENTRY" 2>/dev/null || true
    sync
    say "installed: $BOOT_HALT_EFI + $BOOT_HALT_ENTRY (Secure Boot=$BOOT_SB)"
    echo
    echo "installed. Now: s5-boot-halt armar   (and power off to test it)"
}

armar() {
    exigir_root
    # The marker from the PREVIOUS rehearsal is deleted here: that way what is read afterwards is from
    # this one, and there is no need to trust when it was last run.
    borrar_var "$(marca_path)"
    # Arming lives in system/bin/s5-politica-boot, which is what the
    # policy calls during poweroff: a SINGLE implementation, and this order only
    # uses it to rehearse (--armar-solo = arm and do NOT reboot).
    if [ ! -x "$HERE/system/bin/s5-politica-boot" ]; then
        echo "cannot find $HERE/system/bin/s5-politica-boot" >&2
        return 1
    fi
    S5_POLITICA_LOG="$LOG" S5_DESCUBRE_BOOT="$HERE/system/bin/s5-descubre-boot" \
        "$HERE/system/bin/s5-politica-boot" --armar-solo
}

abortar() {
    exigir_root
    v=$(ls -1 "$BOOT_EFIVARS"/LoaderEntryOneShot-* 2>/dev/null | head -1)
    if [ -z "${v:-}" ]; then
        echo "there was nothing armed"
        return 0
    fi
    # `bootctl set-oneshot ''` does not work to delete on all versions, and a plain `rm`
    # does NOT either: EFI variables are immutable (----i---- in lsattr) and the
    # kernel returns EPERM. The attribute must be removed first, which is what
    # bootctl does internally.
    chattr -i "$v" 2>/dev/null || true
    rm -f "$v" 2>/dev/null || true
    if [ -e "$v" ]; then
        echo "could not delete $v (no permissions? try: sudo chattr -i $v && sudo rm -f $v)" >&2
        return 1
    fi
    sync
    say "DISARMED: LoaderEntryOneShot variable deleted"
    echo "disarmed"
}

case "${1:-estado}" in
estado)   estado ;;
instalar) instalar ;;
armar)    armar ;;
abortar)  abortar ;;
*)        sed -n '13,18p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
