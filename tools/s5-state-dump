#!/bin/bash
# s5-state-dump — el giro del 2026-08-10: en vez de preguntar QUE HACE Linux,
# preguntar QUE SE QUEDA ENCENDIDO.
#
# Para entonces la biseccion ACPI se habia quedado sin banda: no quedaba ningun
# mecanismo ACPI sin exonerar (la lista entera esta en "What has been cleared,
# and by which measurement", docs/EVIDENCE.md) y las dos tablas que habrian sido
# candidatas (APEI y PRMT) ni existen en este equipo. Lo que no se habia hecho
# en 28 medidas era mirar al CONSUMIDOR. La pista es numerica: `nvidia-smi` con
# la dGPU despierta e inactiva marca 17,4 W, y envenenado medimos 18-22 W.
#
# Este volcado se hace DOS veces —un arranque envenenado (ACPI normal) y uno
# limpio (acpi=off)— y se diffean. La pregunta concreta que responde:
#
#   ¿esta la dGPU (0000:01:00.0) enumerada y con el enlace ARRIBA en el
#    arranque limpio, o el arranque limpio ni la toca?
#
# Si en `acpi=off` la dGPU o su puente GPP0 (0000:00:01.1) no aparecen o tienen
# el enlace caido, la correlacion "tablas ACPI" era el proxy de "Linux levanto
# el enlace de la discreta" y se acabo la investigacion.
#
# REGLA DE ORO DE ESTA INVESTIGACION (ya costo una falsa pista): leer el espacio
# de configuracion PCI dispara un runtime-resume del subarbol y FALSEA el
# estado. Por eso el volcado va en dos pases: PASE 1 solo sysfs que no toca
# config space; PASE 2 (enlaces, lspci, setpci) despues, cuando ya da igual.
#
# Uso:  s5-state-dump ETIQUETA        -> /var/log/s5-state/ETIQUETA.txt
#
# Escrito para correr en entornos pelados (sin systemd, sin udev y quiza sin
# ACPI): nada de systemctl, nada de udevadm, y todo fallo es no fatal.

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

LABEL=${1:-sin-etiqueta}
case "$LABEL" in *[!A-Za-z0-9._-]*) echo "etiqueta invalida" >&2; exit 1 ;; esac

DIR=/var/log/s5-state
OUT="$DIR/$LABEL.txt"
# LA CONFIGURACION, LEIDA AQUI Y NO DE REBOTE. Este fichero no la sourceaba: se
# apoyaba en que el descubridor de mas abajo la lee por su cuenta, y eso NO
# funcionaba porque $BAT se resolvia SEIS LINEAS ANTES de ese `.`. Con
# S5_BAT= puesto en la conf, este volcado seguia leyendo BAT0 en silencio
# mientras el resto del proyecto obedecia — o sea el mismo desajuste de dos
# lectores mirando celdas distintas que se arreglo en s5-energy-log el
# 2026-08-14, escondido en el orden de dos lineas.
S5_CONF=${S5_CONF:-/etc/s5-poweroff-fix.conf}
# shellcheck source=/dev/null
[ -r "$S5_CONF" ] && . "$S5_CONF"
# primera BAT* encontrada; escape con S5_BAT= (ver la conf de ejemplo)
BAT="${S5_BAT:-$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -1)}"
# QUE dispositivos. Antes estaban clavados aqui, o sea los de la maquina donde se
# diagnostico esto; en cualquier otra ese BDF puede ser el NVMe. Salen de sysfs.
DESCUBRE=${S5_DESCUBRE:-/usr/local/bin/s5-descubre-dgpu}
GPU=''; AUDIO=''; BRIDGE=''
# shellcheck source=/dev/null
[ -r "$DESCUBRE" ] && . "$DESCUBRE"
[ -n "$GPU" ] || { echo "$(basename "$0"): no encuentro la dGPU (falta $DESCUBRE, o esta maquina no lleva discreta del vendor buscado)" >&2; exit 1; }

mkdir -p "$DIR" 2>/dev/null
rd() { local v=''; [ -r "$1" ] || { printf '?'; return; }; read -r v < "$1" 2>/dev/null; printf '%s' "${v:-?}"; }

{
printf '===== VOLCADO DE ESTADO  etiqueta=%s\n' "$LABEL"
printf 'FECHA    %s\n' "$(date '+%F %T')"
printf 'KERNEL   %s\n' "$(uname -r)"
printf 'UPTIME   %s s\n' "$(cut -d' ' -f1 /proc/uptime)"
printf 'CMDLINE  %s\n' "$(cat /proc/cmdline)"
printf 'PROCESOS %s\n' "$(ls -d /proc/[0-9]* 2>/dev/null | wc -l)"
printf 'ACPI     tablas=%s bus_devices=%s\n' \
    "$(ls /sys/firmware/acpi/tables 2>/dev/null | wc -l)" \
    "$(ls /sys/bus/acpi/devices 2>/dev/null | wc -l)"

# --------------------------------------------------------------- PASE 1 ------
# SOLO atributos que NO leen el espacio de configuracion. Este es el pase que
# de verdad vale: cualquier cosa de aqui en adelante puede haber despertado
# dispositivos.
echo
echo "--- PASE 1: estado PCI por sysfs puro (no toca config space) ---"
printf '%-14s %-6s %-10s %-12s %-6s %-9s %s\n' \
    DISPOSITIVO ESTADO RUNTIME DRIVER ENABLE D3COLD_OK CLASE
for d in /sys/bus/pci/devices/*; do
    [ -e "$d" ] || continue
    dev=${d##*/}
    drv='-'; [ -L "$d/driver" ] && { drv=$(readlink "$d/driver"); drv=${drv##*/}; }
    printf '%-14s %-6s %-10s %-12s %-6s %-9s %s %s:%s\n' \
        "$dev" "$(rd "$d/power_state")" "$(rd "$d/power/runtime_status")" \
        "$drv" "$(rd "$d/enable")" "$(rd "$d/d3cold_allowed")" \
        "$(rd "$d/class")" "$(rd "$d/vendor")" "$(rd "$d/device")"
done
printf 'PCI  total_dispositivos=%s\n' "$(ls /sys/bus/pci/devices 2>/dev/null | wc -l)"
printf 'PCI  dGPU_presente=%s  audio_presente=%s  puente_presente=%s\n' \
    "$([ -e /sys/bus/pci/devices/$GPU ] && echo SI || echo NO)" \
    "$([ -e /sys/bus/pci/devices/$AUDIO ] && echo SI || echo NO)" \
    "$([ -e /sys/bus/pci/devices/$BRIDGE ] && echo SI || echo NO)"

echo
echo "--- PASE 1: runtime PM del subarbol de la dGPU ---"
for d in "$BRIDGE" "$GPU" "$AUDIO"; do
    p=/sys/bus/pci/devices/$d
    [ -e "$p" ] || { printf '%s AUSENTE\n' "$d"; continue; }
    printf '%s power_state=%s runtime=%s control=%s usage=%s activos_hijos=%s autosuspend=%s\n' \
        "$d" "$(rd "$p/power_state")" "$(rd "$p/power/runtime_status")" \
        "$(rd "$p/power/control")" "$(rd "$p/power/runtime_usage")" \
        "$(rd "$p/power/runtime_active_kids")" "$(rd "$p/power/autosuspend_delay_ms")"
done

echo
echo "--- PASE 1: termica (donde se disipan los vatios) ---"
for h in /sys/class/hwmon/hwmon*; do
    [ -e "$h" ] || continue
    n=$(rd "$h/name")
    for t in "$h"/temp*_input; do
        [ -e "$t" ] || continue
        printf 'HWMON %-12s %-16s %s mC  (%s)\n' "${h##*/}" "$n" "$(rd "$t")" \
            "$(rd "${t%_input}_label")"
    done
    for p in "$h"/power*_input "$h"/curr*_input "$h"/in*_input; do
        [ -e "$p" ] || continue
        printf 'HWMON %-12s %-16s %s = %s\n' "${h##*/}" "$n" "${p##*/}" "$(rd "$p")"
    done
done
for z in /sys/class/thermal/thermal_zone*; do
    [ -e "$z" ] || continue
    printf 'TEMP  %-12s %-16s %s mC\n' "${z##*/}" "$(rd "$z/type")" "$(rd "$z/temp")"
done
for c in /sys/class/thermal/cooling_device*; do
    [ -e "$c" ] || continue
    printf 'FAN   %-12s %-16s estado=%s/%s\n' "${c##*/}" "$(rd "$c/type")" \
        "$(rd "$c/cur_state")" "$(rd "$c/max_state")"
done

echo
echo "--- PASE 1: bateria / AC ---"
for f in status capacity energy_now power_now voltage_now current_now temp; do
    printf 'BAT %s=%s\n' "$f" "$(rd "$BAT/$f")"
done
for a in /sys/class/power_supply/A*; do
    [ -e "$a/online" ] && printf 'AC  %s online=%s\n' "${a##*/}" "$(rd "$a/online")"
done

echo
echo "--- PASE 1: CPU / frecuencias / idle ---"
printf 'CPU nucleos=%s online=%s driver=%s gobernador=%s\n' \
    "$(grep -c ^processor /proc/cpuinfo)" "$(rd /sys/devices/system/cpu/online)" \
    "$(rd /sys/devices/system/cpu/cpu0/cpufreq/scaling_driver)" \
    "$(rd /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor)"
printf 'CPU idle_driver=%s estados=%s\n' \
    "$(rd /sys/devices/system/cpu/cpuidle/current_driver)" \
    "$(ls /sys/devices/system/cpu/cpu0/cpuidle 2>/dev/null | tr '\n' ' ')"
modprobe msr >/dev/null 2>&1
_M=$(dd if=/dev/cpu/0/msr bs=8 count=1 skip=$((0xc00102b1)) iflag=skip_bytes status=none 2>/dev/null | od -An -tx8 | tr -d ' ')
printf 'MSR cppc_enable(0xc00102b1)=%s\n' "${_M:-no_legible}"

echo
echo "--- PASE 1: EC (la RAM de la EC es lo que sobrevive al POST) ---"
mount -t debugfs debugfs /sys/kernel/debug >/dev/null 2>&1
modprobe ec_sys >/dev/null 2>&1
if [ -r /sys/kernel/debug/ec/ec0/io ]; then
    od -Ax -tx1 /sys/kernel/debug/ec/ec0/io 2>/dev/null | sed 's/^/EC /'
else
    echo "EC no accesible (sin ec_sys o sin ACPI: es lo esperado con acpi=off)"
fi
if [ -r /sys/kernel/debug/gpio ]; then
    sed 's/^/GPIO /' /sys/kernel/debug/gpio 2>/dev/null | head -80
fi
for f in /sys/kernel/debug/dri/*/amdgpu_pm_info; do
    [ -r "$f" ] && { echo "--- $f ---"; sed 's/^/SMU /' "$f" 2>/dev/null | head -40; }
done

echo
echo "--- PASE 1: interrupciones y modulos ---"
sed 's/^/IRQ /' /proc/interrupts 2>/dev/null
printf 'MODULOS (%s): ' "$(($(lsmod | wc -l) - 1))"
lsmod | tail -n +2 | awk '{printf "%s ", $1} END {print ""}'

# --------------------------------------------------------------- PASE 2 ------
# A partir de aqui SI se lee el espacio de configuracion: despierta dispositivos.
# Nada de lo de abajo sirve para juzgar en que estado de energia ESTABAN.
echo
echo "===== PASE 2: a partir de aqui se lee config space (despierta el bus) ====="
echo "--- enlaces PCIe (velocidad/anchura actuales) ---"
for d in /sys/bus/pci/devices/*; do
    [ -e "$d/current_link_speed" ] || continue
    dev=${d##*/}
    printf 'ENLACE %-14s actual=%s x%s  max=%s x%s\n' "$dev" \
        "$(rd "$d/current_link_speed")" "$(rd "$d/current_link_width")" \
        "$(rd "$d/max_link_speed")" "$(rd "$d/max_link_width")"
done

echo
echo "--- registros clave del subarbol de la dGPU (setpci) ---"
for d in "$BRIDGE" "$GPU" "$AUDIO"; do
    if [ -e /sys/bus/pci/devices/$d ]; then
        printf '%s LnkCap=%s LnkCtl=%s LnkSta=%s PMCSR=%s\n' "$d" \
            "$(setpci -s "$d" CAP_EXP+0c.l 2>/dev/null)" \
            "$(setpci -s "$d" CAP_EXP+10.w 2>/dev/null)" \
            "$(setpci -s "$d" CAP_EXP+12.w 2>/dev/null)" \
            "$(setpci -s "$d" CAP_PM+4.w 2>/dev/null)"
    else
        printf '%s AUSENTE\n' "$d"
    fi
done

echo
echo "--- lspci -nnvv completo ---"
lspci -nnvv 2>&1

echo
echo "--- dmesg completo ---"
dmesg 2>/dev/null
echo "===== FIN $LABEL"
} > "$OUT" 2>&1

chmod 0600 "$OUT" 2>/dev/null
restorecon "$OUT" 2>/dev/null
echo "s5-state-dump: escrito $OUT ($(wc -l < "$OUT") lineas)"
