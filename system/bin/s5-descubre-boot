#!/bin/bash
# s5-descubre-boot — locates what is needed to power off from the FIRMWARE on
# a machine with systemd-boot (the equivalent of GRUB's `halt`).
#
# It is USED WITH `.` (source), not executed: it leaves set
#
#     BOOT_ESP        ESP mount point (/boot, /efi, /boot/efi...)
#     BOOT_BOOTCTL    the bootctl binary, or empty
#     BOOT_ONESHOT    "yes" if this systemd-boot understands one-shot entries
#     BOOT_EFIVARS    /sys/firmware/efi/efivars (needed for arming)
#     BOOT_RUTA       app | builtin: which entry is used to power off
#     BOOT_ARMAR_ID   the id that goes into the one-shot variable
#     BOOT_HALT_ID    identifier of the application entry (s5-halt)
#     BOOT_HALT_EFI   path of the EFI poweroff application ON THE ESP
#     BOOT_HALT_ENTRY entry file in $BOOT_ESP/loader/entries
#     BOOT_LIMITE     why it CANNOT be used, if it cannot (text or empty)
#     BOOT_AVISO      what could not be checked and does NOT block the route
#
# TWO DIFFERENT QUESTIONS, and confusing them cost a false limit. INSTALLING asks for
# the ESP mounted; ARMING does not: `bootctl set-oneshot` writes an EFI variable and does not
# touch the ESP. With S5_BOOT_ARMAR=1 the question is the second one, and what is only needed
# for installing becomes BOOT_AVISO instead of BOOT_LIMITE. It is what allows arming
# in the real window, with /boot already unmounted.
#
# and it empties whatever it does not find, so that the caller decides (all those that use it
# fail safe: it is recorded and the poweroff continues its normal course).
#
# WHY IT EXISTS. The rare-case branch of s5-gpu-politica powers off from GRUB with
# `halt`, and that works because in that boot NO Linux
# kernel ever gets to run: the firmware does its own S5 with the hardware just as
# POST left it. On a machine with systemd-boot there is no `halt` that works, so
# the equivalent is a one-shot entry that boots an EFI application of
# three instructions (ResetSystem(EfiResetShutdown)) — no kernel, no disk,
# nothing that can turn the dGPU back on.
#
# Each thing is detected SEPARATELY and one is not inferred from another, for the same
# reason as in s5-descubre-grub: having `bootctl` does not imply having the ESP
# mounted, nor that this firmware lets you write EFI variables. Everything missing is
# named outright in BOOT_LIMITE.
#
# MANUAL ESCAPE in /etc/s5-poweroff-fix.conf: S5_ESP, S5_BOOTCTL and
# S5_BOOT_ENTRIES. Whatever is set there wins and is not even searched for.
#
#   s5-descubre-boot          run bare, it prints what it finds
#
# S5_ESP_DIRS exists ONLY for rehearsal (rule 22): it allows pointing the search at
# fake directories and triggering the branches without touching the real ESP.

S5_CONF=${S5_CONF:-/etc/s5-poweroff-fix.conf}
# shellcheck source=/dev/null
[ -r "$S5_CONF" ] && . "$S5_CONF"

BOOT_ESP="${S5_ESP:-}"
BOOT_BOOTCTL="${S5_BOOTCTL:-}"
BOOT_ENTRIES="${S5_BOOT_ENTRIES:-}"
BOOT_HALT_ID=s5-halt
BOOT_ONESHOT=''
BOOT_LIMITE=''
BOOT_SB=''

# --- the route, and in which MODE it is asked ------------------------------------
# ROUTE. `app` (the default) powers off with s5-halt.efi, so the entry and the
# application live on the ESP. `builtin` uses systemd-boot's built-in entry
# ("Power Off The System", which exists with `auto-poweroff yes` in loader.conf): the
# entry is provided by the boot loader and there is nothing to install on the ESP.
BOOT_RUTA=${S5_BOOT_RUTA:-app}
if [ "$BOOT_RUTA" = builtin ]; then
    BOOT_ARMAR_ID=auto-poweroff
else
    BOOT_ARMAR_ID=$BOOT_HALT_ID
fi

# MODE. And mode matters as much as route, because INSTALLING and ARMING do not ask for the
# same thing. Installing needs the ESP mounted; arming does NOT: `bootctl set-oneshot` writes
# an EFI variable and does not touch the ESP. Checked on 2026-10-07 with
# `bootctl --esp-path=<nonexistent dir> set-oneshot ...`: it reaches the variable
# write and only fails on permissions. That matters because the real window is
# exactly when the ESP is already gone: measured on 2026-08-11, boot.mount is unmounted
# 100 ms BEFORE `shutdown.target` is reached. With S5_BOOT_ARMAR=1, what
# is only needed for installing becomes a warning (BOOT_AVISO) and not a limit; what
# is needed for arming (bootctl and efivarfs) is still a limit.
BOOT_ARMAR=${S5_BOOT_ARMAR:-0}
BOOT_AVISO=''

# A warning and a limit are not the same: a warning is stated and you go on; a limit stops the
# route. The distinction exists so as not to declare dead a route that works.
avisar() { BOOT_AVISO="${BOOT_AVISO:+$BOOT_AVISO; }$1"; }
limitar() { BOOT_LIMITE="${BOOT_LIMITE:+$BOOT_LIMITE; }$1"; }

# Is the ESP available RIGHT NOW? It is not the same as "an ESP exists": in the
# poweroff window the path is still set but the mount is not.
esp_ahora() { [ -n "$BOOT_ESP" ] && [ -d "$BOOT_ESP/loader/entries" ] && [ -d "$BOOT_ESP/EFI" ]; }

# --- the ESP ---------------------------------------------------------------
# First bootctl is asked, since it already knows how to read /etc/fstab and the real
# mount; and only if it is not there is the usual list tried. The order matters: an
# ESP mounted in an odd place is exactly the case the list does not cover.
if [ -z "$BOOT_ESP" ] && [ -n "$BOOT_BOOTCTL" ]; then
    BOOT_ESP="$("$BOOT_BOOTCTL" --print-esp-path 2>/dev/null)"
fi
if [ -z "$BOOT_ESP" ]; then
    for d in ${S5_ESP_DIRS:-/boot /efi /boot/efi}; do
        [ -d "$d/loader" ] || [ -d "$d/EFI" ] || continue
        BOOT_ESP="$d"
        break
    done
fi
# The ESP must have BOTH things: `loader/entries`, which is where the
# entry goes, and `EFI`, which is where the application goes. A /boot that only has
# vmlinuz (the case of a machine with GRUB and a separate /boot) will not do. But that is
# an INSTALLATION condition: if what is going to be done is arming and the ESP is not
# mounted, it is not a limit — it is the real window, and arming does not need it.
if ! esp_ahora; then
    if [ "$BOOT_ARMAR" = 1 ]; then
        avisar "${BOOT_ESP:-(no ESP)} is not available right now (arming does not need it: 'bootctl set-oneshot' writes an EFI variable)"
    else
        limitar "${BOOT_ESP:-(no ESP)} does not look like a systemd-boot ESP (missing loader/entries or EFI)"
    fi
fi

# --- bootctl and the one-shot entry ---------------------------------
if [ -z "$BOOT_BOOTCTL" ]; then
    for c in bootctl; do
        command -v "$c" >/dev/null 2>&1 && { BOOT_BOOTCTL="$(command -v "$c")"; break; }
    done
fi
[ -n "$BOOT_BOOTCTL" ] || BOOT_LIMITE="${BOOT_LIMITE:+$BOOT_LIMITE; }no bootctl found"

# The capability is asked, not inferred from the version: `bootctl status` publishes
# the list of Features of the boot loader on the ESP, and "One-shot entry
# control" is there. It is the same code that writes both things, so this is a
# direct read and not an assumption about versions.
if [ -n "$BOOT_BOOTCTL" ]; then
    if "$BOOT_BOOTCTL" status 2>/dev/null | grep -q 'One-shot entry control'; then
        BOOT_ONESHOT=yes
    elif [ "$BOOT_ARMAR" = 1 ] && ! esp_ahora; then
        # Without the ESP it cannot be asked. It arms anyway: arming is writing an
        # EFI variable, and the boot loader's capability was checked at install time. It
        # states what could not be checked now.
        avisar "cannot check 'One-shot entry control' without the ESP (it was checked at install time)"
    else
        limitar "this systemd-boot does not advertise 'One-shot entry control'"
    fi
fi

# --- EFI variables --------------------------------------------------------
# Arming a one-shot entry means writing LoaderEntryOneShot in efivarfs.
# If it is not mounted or the firmware does not allow it, there is nothing to do and it must be
# stated here and not halfway through a poweroff.
BOOT_EFIVARS=/sys/firmware/efi/efivars
if [ ! -d "$BOOT_EFIVARS" ]; then
    BOOT_EFIVARS=''
    BOOT_LIMITE="${BOOT_LIMITE:+$BOOT_LIMITE; }no efivarfs (non-EFI boot?)"
elif [ ! -w "$BOOT_EFIVARS" ]; then
    # Without root this is normal; it is left stated but does NOT count as a limit: whoever
    # arms runs as root and the `-w` here would be a false negative that would leave
    # the branch dead in silence.
    BOOT_EFIVARS="$BOOT_EFIVARS"
fi

# --- Secure Boot, which is the real limit ---------------------------------
# The poweroff application is compiled and signed by the user, and with Secure Boot
# enabled the firmware only loads images signed by a key it knows. If it is
# not signed, systemd-boot does not load it, the menu comes back and the
# default entry boots: a benign failure, but the saving is lost. It is detected in
# order to be able to warn BEFOREHAND (at installation) and not during a poweroff.
if [ -n "$BOOT_BOOTCTL" ] && "$BOOT_BOOTCTL" status 2>/dev/null | grep -q 'Secure Boot: enabled'; then
    BOOT_SB=yes
fi

# --- the two pieces on the ESP -------------------------------------------
if [ -n "$BOOT_ENTRIES" ]; then
    BOOT_HALT_ENTRY="$BOOT_ENTRIES/$BOOT_HALT_ID.conf"
elif [ -n "$BOOT_ESP" ]; then
    BOOT_HALT_ENTRY="$BOOT_ESP/loader/entries/$BOOT_HALT_ID.conf"
else
    BOOT_HALT_ENTRY=''
fi
if [ -n "$BOOT_ESP" ]; then
    BOOT_HALT_EFI="$BOOT_ESP/EFI/s5-halt/s5-halt.efi"
else
    BOOT_HALT_EFI=''
fi

# The built-in entry is provided by the boot loader, but only if loader.conf
# enables it. With the ESP present that IS a limit: without `auto-poweroff yes` the
# entry does not exist and arming that id powers off nothing. Without the ESP it cannot be read;
# it is stated, and what was checked at install time governs.
if [ "$BOOT_RUTA" = builtin ]; then
    if esp_ahora; then
        grep -qE '^[[:space:]]*auto-poweroff[[:space:]]+yes' "$BOOT_ESP/loader/loader.conf" 2>/dev/null \
            || limitar "$BOOT_ESP/loader/loader.conf does not enable 'auto-poweroff yes': there would be no entry to arm"
    else
        avisar "cannot read loader.conf without the ESP (the 'auto-poweroff yes' was checked at install time)"
    fi
fi

if [ -n "$BOOT_LIMITE" ]; then
    BOOT_ONESHOT=''
fi

# Executed instead of sourced: a report to check before installing.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    printf 'route              : %s (id to arm: %s)\n' "$BOOT_RUTA" "$BOOT_ARMAR_ID"
    printf 'ESP                : %s\n' "${BOOT_ESP:-(not found)}"
    printf 'bootctl            : %s\n' "${BOOT_BOOTCTL:-(not found)}"
    printf 'one-shot entry     : %s\n' "${BOOT_ONESHOT:-NO}"
    printf 'efivarfs           : %s\n' "${BOOT_EFIVARS:-NO}"
    printf 'Secure Boot        : %s\n' "${BOOT_SB:-(disabled or unknown)}"
    printf 'entry              : %s%s\n' "${BOOT_HALT_ENTRY:-(no ESP)}" \
        "$([ -n "$BOOT_HALT_ENTRY" ] && [ -e "$BOOT_HALT_ENTRY" ] && echo '  (already written)' || echo '  (missing)')"
    printf 'EFI application    : %s%s\n' "${BOOT_HALT_EFI:-(no ESP)}" \
        "$([ -n "$BOOT_HALT_EFI" ] && [ -e "$BOOT_HALT_EFI" ] && echo '  (already installed)' || echo '  (missing)')"
    if [ -n "$BOOT_AVISO" ]; then
        echo
        echo "WARNING (does not block the route): $BOOT_AVISO"
    fi
    if [ -n "$BOOT_LIMITE" ]; then
        echo
        echo "CANNOT BE USED: $BOOT_LIMITE"
        exit 1
    fi
    echo
    echo 'Can be used: the policy can route the rare case through here.'
fi
