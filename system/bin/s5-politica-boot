#!/bin/bash
# s5-politica-boot — the RARE CASE branch when there is no GRUB: systemd-boot.
#
# WHAT IT DOES, in order:
#   1. discover (s5-descubre-boot) and, if something is missing, say so and exit WITHOUT touching anything
#   2. arm the one-shot entry (an EFI variable) and VERIFY it
#   3. reboot so that systemd-boot boots s5-halt.efi, which powers off from the
#      firmware before a kernel ever gets to run
#
# Usage:
#   s5-politica-boot              arms and reboots (called by s5-gpu-politica)
#   s5-politica-boot --armar-solo arms and does NOT reboot (rehearsal: leaves the arming in place)
#   S5_POLITICA_DRYRUN=1 ...      writes nothing, only says what it would do
#
# WHY IT EXISTS. The GRUB branch powers off with `halt` because in that boot no
# Linux kernel ever gets to run: the firmware does its own S5 with the hardware just
# as POST left it, and the measurement comes out clean (`grub-halt`, 1,05 W, 2026-08-09).
# On a machine with systemd-boot there is no `halt`, and doing it from a live kernel is NOT
# equivalent — measured and in docs/EVIDENCE.md: a module that calls ResetSystem
# through EFI leaves S5 at 19,26 W, and writing PM1a_CNT without `_PTS(5)` or
# `device_shutdown()` leaves it at 26,56 W. The whole mechanism is in
# docs/systemd-boot-halt.md.
#
# ADVANTAGE OVER THE GRUB BRANCH, and it is not small: here there is NO need to mount /boot.
# Mounts die before `shutdown.target` (measured on 2026-08-11: boot.mount
# is unmounted 100 ms BEFORE shutdown.target is reached), so the GRUB branch
# has to mount it itself to write its custom.cfg. Here the entry
# is written at installation time and arming is only writing an EFI variable, which
# lives in efivarfs and stays mounted. Fewer things that can fail in the most delicate
# window of the poweroff.
#
# FAIL SAFE, ALWAYS, and with the same doctrine as the policy: if the
# discovery script finds a limit, if the variable does not end up written, if the
# reboot does not go through — it is recorded, it is stated, and the poweroff continues its normal
# course. The saving is lost; the poweroff is not broken.
#
# ANTI-LOOP. The entry is one-shot (the variable is consumed by systemd-boot) and
# also s5-halt.efi DELETES that variable before powering off: even if the firmware did not
# get to power off, the next boot is the normal one. The entry stays
# written on purpose and uninstall.sh sweeps it away.

set -u

BIN=${S5_BIN:-/usr/local/bin}
DESCUBRE=${S5_DESCUBRE_BOOT:-$BIN/s5-descubre-boot}
LOG=${S5_POLITICA_LOG:-/var/log/s5-shutdown-pci.log}
DRYRUN=${S5_POLITICA_DRYRUN:-0}
FRENO=${S5_FRENO:-/var/lib/s5-test/gpu-politica-disabled}
SOLO_ARMAR=0
[ "${1:-}" = "--armar-solo" ] && SOLO_ARMAR=1

# The log lives in / (btrfs) and in this window / is still rw, but everything goes with
# `|| true` for the same reason as in the policy: a write failure cannot
# kill the script.
say() { printf 'POLITICA-BOOT %s\n' "$*"; printf 'POLITICA-BOOT %s\n' "$*" >>"$LOG" 2>/dev/null || true; }

# Same handbrake as the policy and as hook 99y: if it is set, nothing is
# touched and it is stated.
if [ -e "$FRENO" ]; then
    say "BRAKE: $FRENO exists => firmware poweroff is not armed; normal poweroff"
    exit 1
fi

# The question asked of the discovery script is the ARMING one, not the installing one. In
# this window the ESP is already gone (measured on 2026-08-11: boot.mount is unmounted
# 100 ms before `shutdown.target`) and arming does not need it: `bootctl set-oneshot`
# writes an EFI variable. Without telling it that this is an arming, the discovery script declares
# a limit that does not exist and the route stays dead just when it is needed.
S5_BOOT_ARMAR=1
# shellcheck source=/dev/null
if [ -r "$DESCUBRE" ]; then
    . "$DESCUBRE"
else
    say "missing $DESCUBRE (installed by install.sh) => cannot route through systemd-boot"
    exit 1
fi

say "probe: route=${BOOT_RUTA:-app} id=${BOOT_ARMAR_ID:-?} ESP=${BOOT_ESP:-?} esp_now=$([ -d "${BOOT_ESP:-/nonexistent}/loader/entries" ] && echo yes || echo no) bootctl=${BOOT_BOOTCTL:-?} oneshot_entry=${BOOT_ONESHOT:-NO} efivarfs=${BOOT_EFIVARS:-NO} secureboot=${BOOT_SB:-no}"
[ -n "${BOOT_AVISO:-}" ] && say "WARNING (does not block the route): $BOOT_AVISO"
if [ -n "$BOOT_LIMITE" ]; then
    say "CANNOT: $BOOT_LIMITE"
    exit 1
fi
# What IS needed to arm: where to write the variable and with what.
if [ -z "$BOOT_EFIVARS" ] || [ -z "$BOOT_BOOTCTL" ]; then
    say "CANNOT: bootctl and efivarfs are needed to arm"
    exit 1
fi
# The application entry is checked only if the ESP is present: if it is not
# there is nothing to read, and what was checked at install time governs. On the
# `builtin` route there is no application to check: the entry is provided by the boot loader.
if [ "${BOOT_RUTA:-app}" != builtin ] && [ -d "${BOOT_ESP:-/nonexistent}/loader/entries" ]; then
    if [ ! -e "$BOOT_HALT_EFI" ] || [ ! -e "$BOOT_HALT_ENTRY" ]; then
        say "CANNOT: missing the application or the entry on the ESP (sudo $BIN/s5-boot-halt instalar)"
        exit 1
    fi
fi

if [ "$DRYRUN" = 1 ]; then
    say "DRYRUN: here it would run '$BOOT_BOOTCTL set-oneshot $BOOT_ARMAR_ID' and reboot"
    say "DRYRUN: the systemd-boot route WOULD have acted (effective=$([ "$SOLO_ARMAR" = 1 ] && echo no || echo yes))"
    exit 0
fi

# --- 1. arm ---------------------------------------------------------------
# The id comes from the route: `s5-halt` (our application, which leaves the marker) or
# `auto-poweroff` (the boot loader's built-in entry, which leaves none).
"$BOOT_BOOTCTL" set-oneshot "$BOOT_ARMAR_ID" >/dev/null 2>&1
rc=$?
if [ "$rc" != 0 ]; then
    say "ARM FAILED: '$BOOT_BOOTCTL set-oneshot $BOOT_ARMAR_ID' rc=$rc => normal poweroff"
    exit 1
fi

# The check that counts is reading the variable, not the tool's rc: it is what
# systemd-boot is going to read at boot. efivarfs prepends 4 attribute bytes to
# each variable, so the content starts at byte 5: without skipping them the value
# is "\x07s5-halt", the comparison fails even though the arming is correct, and this
# route declares itself unavailable without telling the truth.
v=$(ls -1 "$BOOT_EFIVARS"/LoaderEntryOneShot-* 2>/dev/null | head -1)
if [ -z "${v:-}" ] || [ "$(tail -c +5 <"$v" 2>/dev/null | tr -d '\0')" != "$BOOT_ARMAR_ID" ]; then
    say "ARM FAILED: the EFI variable did not end up with '$BOOT_ARMAR_ID' => normal poweroff"
    exit 1
fi

if [ "${BOOT_RUTA:-app}" = builtin ]; then
    say "ARMED: next_entry=$BOOT_ARMAR_ID (EFI variable verified). The next boot is powered off by the boot loader's built-in entry, without a kernel"
else
    say "ARMED: next_entry=$BOOT_ARMAR_ID (EFI variable verified). The next boot is done by s5-halt.efi"
fi
[ "$SOLO_ARMAR" = 1 ] && exit 0

# --- 2. reboot -----------------------------------------------------------
# Same path as the policy: `systemctl --force reboot` unmounts or remounts
# read-only, and if it does not go through it brings down by hand whatever is left and uses
# `reboot -f`, which is the bare system call.
sync
say "rebooting so that systemd-boot powers off from the firmware (you will see a POST; this is expected)"
systemctl --force reboot >/dev/null 2>&1

sleep 3
say "systemctl --force reboot did not go through; using reboot -f"
sync
mount -o remount,ro / 2>/dev/null || true
sync
exec reboot -f
